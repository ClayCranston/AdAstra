# Copy to .env.local for direct npm development. Docker supplies local defaults.
NEXTAUTH_URL=http://localhost:3000
# Generate a secret before connecting Google: openssl rand -base64 32
NEXTAUTH_SECRET=
LOCAL_DEMO_AUTH=true
DATABASE_PATH=./data/adastra.sqlite
# Optional: Google Cloud Web OAuth client. Callback:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
